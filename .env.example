# Supabase (shared database)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Monri Payment Gateway
MONRI_MERCHANT_KEY=your_merchant_key
MONRI_AUTHENTICITY_TOKEN=your_40_char_authenticity_token
MONRI_ENVIRONMENT=test  # "test" or "production"

# Email (Resend) - for sending activation emails
RESEND_API_KEY=re_...

# Site URLs
NEXT_PUBLIC_SITE_URL=https://brendiapro.hr
NEXT_PUBLIC_PLATFORM_URL=https://app.brendiapro.hr

# Fakturko (automatsko izdavanje računa)
FAKTURKO_API_URL=https://testapi.fakturko.hr
FAKTURKO_API_USERNAME=your_fakturko_username
FAKTURKO_API_PASSWORD=your_fakturko_password
# KPD šifra za tečajeve (potvrditi s knjigovođom!)
FAKTURKO_KPD_CODE=85.59.19
# Opcionalno: fiskalna poslovna jedinica / naplatni uređaj (iz Fakturko API-ja)
# FAKTURKO_POSL_JEDINICA_ID=
# FAKTURKO_NAPL_UREDAJ_ID=
