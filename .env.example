# Supabase (shared database)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Payment mode: "predracun" (bank transfer) or "card" (Stripe Checkout)
NEXT_PUBLIC_PAYMENT_MODE=card

# Installments (Stripe subscription schedule) — hidden until the client approves
NEXT_PUBLIC_INSTALLMENTS_ENABLED=false

# Email (Resend) - for sending activation emails
RESEND_API_KEY=re_...

# Site URLs
NEXT_PUBLIC_SITE_URL=https://brendiapro.hr
NEXT_PUBLIC_PLATFORM_URL=https://app.brendiapro.hr

# Fakturko (automatsko izdavanje računa)
FAKTURKO_API_URL=https://testapi.fakturko.hr
FAKTURKO_API_USERNAME=your_fakturko_username
FAKTURKO_API_PASSWORD=your_fakturko_password
# KPD šifra za tečajeve (potvrditi s knjigovođom!)
FAKTURKO_KPD_CODE=85.59.19
# Opcionalno: fiskalna poslovna jedinica / naplatni uređaj (iz Fakturko API-ja)
# FAKTURKO_POSL_JEDINICA_ID=
# FAKTURKO_NAPL_UREDAJ_ID=

# Moj-eRačun (MER) — B2B eRačuni za kupce-tvrtke
# Produkcija: MER_API_URL=https://www.moj-eracun.hr
MER_API_URL=https://demo.moj-eracun.hr
MER_USERNAME=...
MER_PASSWORD=...
MER_COMPANY_ID=24477900978
MER_SOFTWARE_ID=...
# Fiskalna numeracija za MER eRačune (potvrditi s knjigovođom!)
MER_POSLOVNI_PROSTOR=WEB1
MER_NAPLATNI_UREDAJ=2
# KPD 2025 šifra za edukacije (85.59.x više NE vrijedi — potvrditi s knjigovođom)
MER_KPD_CODE=85.40.32
